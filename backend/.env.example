PORT=3000
DATABASE_URL=postgresql://username:password@localhost:5432/career_compass
# Ark is primary. Gemini is enabled only when selected explicitly.
AI_PRIMARY_PROVIDER=ark
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Enter the Seed 2.1 Lite model ID or inference endpoint ID from your Ark console.
ARK_MODEL=
ARK_API_KEY=
# Optional UTC daily spend limit in millionths of your billing currency.
ARK_DAILY_SPEND_LIMIT_MICROS=
ARK_INPUT_COST_MICROS_PER_MILLION=
ARK_OUTPUT_COST_MICROS_PER_MILLION=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AUTH_TOKEN_SECRET=
# Optional transactional account email. Resend requires a verified sender.
ACCOUNT_EMAIL_PROVIDER=
ACCOUNT_EMAIL_FROM=
RESEND_API_KEY=
# Optional. Set this only when the backend must reach Gemini through a proxy.
GEMINI_HTTP_PROXY=
# Optional local secondary provider. Set AI_SECONDARY_PROVIDER=ollama and choose an installed model.
AI_SECONDARY_PROVIDER=
OLLAMA_MODEL=
OLLAMA_BASE_URL=

# Shared provider-attempt quotas and per-process rate limits.
AI_ACCOUNT_DAILY_LIMIT=5
AI_GUEST_STAGE_ATTEMPTS=2
AI_MAX_ATTEMPTS_PER_MINUTE=10
AI_MAX_ATTEMPTS_PER_DAY=450
AI_MIN_REQUEST_INTERVAL_MS=3000
AI_ATTEMPT_TIMEOUT_MS=15000
AI_TASK_TIMEOUT_MS=34000

# Optional OpenAI-compatible Chat Completions adapter. Select openai-compatible as primary or secondary.
# Supply the API root including its version path, such as http://127.0.0.1:8000/v1.
AI_OPENAI_COMPATIBLE_BASE_URL=
AI_OPENAI_COMPATIBLE_MODEL=
AI_OPENAI_COMPATIBLE_API_KEY=
